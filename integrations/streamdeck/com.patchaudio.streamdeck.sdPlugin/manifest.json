      "UUID": "com.patchaudio.streamdeck.application",
      "Name": "Application",
      "Icon": "images/action",
      "Tooltip": "Execute a PirateWave action without a keyboard shortcut.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/index.html",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "images/key",
          "TitleAlignment": "middle",
          "FontSize": 12
