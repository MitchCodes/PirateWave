{
  "Name": "PirateWave Audio Mixer",
  "UUID": "com.patchaudio.streamdeck",
  "Version": "1.1.0.0",
  "Author": "PirateWave contributors",
  "Description": "Control PirateWave audio nodes, effects, soundboard and recording slots using buttons and dials.",
  "Icon": "images/plugin",
  "Category": "PirateWave Audio Mixer",
  "CategoryIcon": "images/category",
  "URL": "https://github.com/MitchCodes/PatchAudio-Releases",
  "CodePath": "bin/plugin.mjs",
  "Nodejs": {
    "Version": "24"
  },
  "SDKVersion": 2,
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Actions": [
